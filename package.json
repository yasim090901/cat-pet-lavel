{
  "name": "cat-piano-pet",
  "version": "1.2.0",
  "description": "Desktop pet",
  "main": "main.js",
  "author": "pet <pet@example.com>",
  "homepage": "https://example.com",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --publish never"
  },
  "optionalDependencies": { "uiohook-napi": "1.5.4" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.example.catpianopet",
    "productName": "CatPianoPet",
    "files": ["main.js", "pet.html", "assets/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/uiohook-napi/**/*"],
    "win": { "icon": "build/icon.ico", "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "CatPianoPet.exe" },
    "directories": { "output": "dist" }
  }
}
